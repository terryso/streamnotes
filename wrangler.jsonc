{
  "name": "streamnotes",
  "compatibility_date": "2026-10-01",
  "main": "src/worker.js",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "streamnotes.terryso.dev", "custom_domain": true }
  ]
}
