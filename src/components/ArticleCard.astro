---
import { CATEGORIES } from '../consts';
import { imagesFor, fmtDate, readingMinutes } from '../lib/articles';
import Icon from './Icon.astro';
const { entry, variant = 'card', level = 3, eager = false } = Astro.props;
const d = entry.data;
const img = imagesFor(entry.id);
const H = level === 2 ? 'h2' : 'h3';
const href = `/articles/${entry.id}/`;
const mins = readingMinutes(entry.body);
---
{variant === 'card' ? (
  <article class="acard">
    <a class="acard__media" href={href} tabindex="-1" aria-hidden="true">
      {img && <img src={img.cover.src800} alt="" width="800" height="450" loading={eager ? 'eager' : 'lazy'} decoding="async" />}
    </a>
    <div class="acard__body">
      <div class="meta"><a class="tag" href={`/category/${d.category}/`}>{CATEGORIES[d.category].name}</a></div>
      <H class="acard__title"><a href={href}>{d.title}</a></H>
      <p class="acard__desc">{d.description}</p>
      <div class="meta meta--muted"><time datetime={d.pubDate.toISOString()}>{fmtDate(d.pubDate)}</time><span class="dot">·</span><span><Icon name="clock" size={14} /> {mins} 分钟</span></div>
    </div>
  </article>
) : (
  <article class="arow" data-category={d.category}>
    <a class="arow__media" href={href} tabindex="-1" aria-hidden="true">
      {img && <img src={img.cover.src800} alt="" width="800" height="450" loading="lazy" decoding="async" />}
    </a>
    <div class="arow__body">
      <div class="meta"><a class="tag" href={`/category/${d.category}/`}>{CATEGORIES[d.category].name}</a></div>
      <H class="arow__title"><a href={href}>{d.title}</a></H>
      <p class="arow__desc">{d.description}</p>
      <div class="meta meta--muted"><time datetime={d.pubDate.toISOString()}>{fmtDate(d.pubDate)}</time><span class="dot">·</span><span>{mins} 分钟阅读</span></div>
    </div>
  </article>
)}
