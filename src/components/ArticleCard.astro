---
import { categoryLabel, articlePath, categoryPath, SITE_EN, type Locale } from '../lib/i18n';
import { imagesFor, fmtDate, readingMinutes, type AnyArticle } from '../lib/articles';
import Icon from './Icon.astro';
interface Props {
  entry: AnyArticle;
  variant?: 'card' | 'row';
  level?: 2 | 3;
  eager?: boolean;
  locale?: Locale;
}
const { entry, variant = 'card', level = 3, eager = false, locale = 'zh' } = Astro.props;
const d = entry.data;
const img = imagesFor(entry.id);
const H = level === 2 ? 'h2' : 'h3';
const href = articlePath(entry.id, locale);
const catHref = categoryPath(d.category, locale);
const catName = categoryLabel(d.category, locale).name;
const mins = readingMinutes(entry.body);
const minsLabel = locale === 'en' ? SITE_EN.readingMins(mins) : `${mins} 分钟`;
const minsLabelRow = locale === 'en' ? SITE_EN.readingMins(mins) : `${mins} 分钟阅读`;
---
{variant === 'card' ? (
  <article class="acard">
    <a class="acard__media" href={href} tabindex="-1" aria-hidden="true">
      {img && <img src={img.cover.src800} alt="" width="800" height="450" loading={eager ? 'eager' : 'lazy'} decoding="async" />}
    </a>
    <div class="acard__body">
      <div class="meta"><a class="tag" href={catHref}>{catName}</a></div>
      <H class="acard__title"><a href={href}>{d.cardTitle ?? d.title}</a></H>
      <p class="acard__desc">{d.cardDescription ?? d.description}</p>
      <div class="meta meta--muted"><time datetime={d.pubDate.toISOString()}>{fmtDate(d.pubDate)}</time><span class="dot">·</span><span><Icon name="clock" size={14} /> {minsLabel}</span></div>
    </div>
  </article>
) : (
  <article class="arow" data-category={d.category}>
    <a class="arow__media" href={href} tabindex="-1" aria-hidden="true">
      {img && <img src={img.cover.src800} alt="" width="800" height="450" loading="lazy" decoding="async" />}
    </a>
    <div class="arow__body">
      <div class="meta"><a class="tag" href={catHref}>{catName}</a></div>
      <H class="arow__title"><a href={href} title={d.cardTitle ?? d.title}>{d.cardTitle ?? d.title}</a></H>
      <p class="arow__desc">{d.cardDescription ?? d.description}</p>
      <div class="meta meta--muted"><time datetime={d.pubDate.toISOString()}>{fmtDate(d.pubDate)}</time><span class="dot">·</span><span>{minsLabelRow}</span></div>
    </div>
  </article>
)}
