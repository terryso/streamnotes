---
import { POLYV_TRIAL, POLYV_CONTACT, POLYV_CONTACT_HASH, POLYV_PHONE, utm } from '../consts';
import { ui, type Locale } from '../lib/i18n';
interface Props { campaign: string; medium?: string; locale?: Locale }
const { campaign, medium = 'article', locale = 'zh' } = Astro.props;
const t = ui(locale);
---
<aside class="cta-end" aria-label={t.ctaAria}>
  <div class="cta-end__text">
    <span class="eyebrow">{t.ctaEyebrow}</span>
    <h2 class="cta-end__title">{t.ctaTitle}</h2>
    <p>{t.ctaBody}</p>
  </div>
  <div class="cta-end__actions">
    <a class="btn btn-primary btn-lg" href={utm(POLYV_TRIAL, campaign, medium)} target="_blank" rel="noopener sponsored">{t.ctaTrial}</a>
    <a class="btn btn-ghost-light btn-lg" href={utm(POLYV_CONTACT, campaign, medium, POLYV_CONTACT_HASH)} target="_blank" rel="noopener sponsored">{t.ctaContact}</a>
    <span class="cta-end__note">{t.phone(POLYV_PHONE)}</span>
  </div>
</aside>
