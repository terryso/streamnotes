---
import { POLYV_TRIAL, POLYV_CONTACT, POLYV_CONTACT_HASH, utm } from '../consts';
import { ui, pagePath, type Locale } from '../lib/i18n';
import Icon from './Icon.astro';
interface Props { campaign: string; locale?: Locale }
const { campaign, locale = 'zh' } = Astro.props;
const t = ui(locale);
---
<section class="leadband" aria-label={t.leadAria}>
  <div class="container leadband__inner">
    <div class="leadband__text">
      <span class="eyebrow eyebrow--light">{t.leadEyebrow}</span>
      <h2>{t.leadTitle}</h2>
      <p>{t.leadBody}</p>
    </div>
    <div class="leadband__actions">
      <a class="btn btn-white btn-lg" href={utm(POLYV_TRIAL, campaign, 'leadband')} target="_blank" rel="noopener sponsored">{t.leadTrial}</a>
      <a class="btn btn-ghost-light btn-lg" href={utm(POLYV_CONTACT, campaign, 'leadband', POLYV_CONTACT_HASH)} target="_blank" rel="noopener sponsored">{t.leadContact}</a>
      <a class="leadband__rss" href={pagePath('/rss.xml', locale)}><Icon name="rss" size={16} /> {t.leadRss}</a>
    </div>
  </div>
</section>
