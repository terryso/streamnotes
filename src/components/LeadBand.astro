---
import { CHECKLIST_URL } from '../consts';
import Icon from './Icon.astro';
interface Props { campaign: string }
const { campaign } = Astro.props;
---
<section class="leadband" aria-label="订阅与选型参考">
  <div class="container leadband__inner">
    <div class="leadband__text">
      <span class="eyebrow eyebrow--light">企业直播 · 点播 · 私有化</span>
      <h2>把直播用在培训、营销与客户服务上</h2>
      <p>从需求梳理到平台评估，先用中立的选型清单对照业务场景；也可以按栏目浏览，或通过 RSS 第一时间收到新文章。</p>
    </div>
    <div class="leadband__actions">
      <a class="btn btn-white btn-lg" href={CHECKLIST_URL}>查看选型清单</a>
      <a class="btn btn-ghost-light btn-lg" href="/category/selection/">浏览方案选型</a>
      <a class="leadband__rss" href="/rss.xml"><Icon name="rss" size={16} /> 通过 RSS 订阅新文章</a>
    </div>
  </div>
</section>
