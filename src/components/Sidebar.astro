---
import { HOT_TAGS, POLYV_TRIAL, POLYV_CONTACT, POLYV_CONTACT_HASH, POLYV_PHONE, utm } from '../consts';
import { getArticles, getArticlesEn, imagesFor } from '../lib/articles';
import { SITE_EN, articlePath, type Locale } from '../lib/i18n';
interface Props {
  campaign: string;
  medium?: string;
  toc?: { depth: number; slug: string; text: string }[];
  exclude?: string;
  locale?: Locale;
}
const { campaign, medium = 'sidebar', toc = [], exclude, locale = 'zh' } = Astro.props;
const isEn = locale === 'en';
const popular = (isEn ? await getArticlesEn() : await getArticles()).filter((a) => a.id !== exclude).slice(0, 4);
const hotTags = isEn ? SITE_EN.hotTags : HOT_TAGS;
const searchBase = isEn ? '/en/search/' : '/search/';
---
<aside class="sidebar">
  <section class="side-cta">
    <span class="eyebrow eyebrow--light">{isEn ? 'Enterprise video' : '企业视频方案'}</span>
    <h3>{isEn ? 'Try live, VOD, and private deploy in one place' : '直播、点播、私有化，一站式试用'}</h3>
    <p>{isEn ? 'Validate on real networks and devices before you decide.' : '在真实网络和终端上先测一测，再做决定。'}</p>
    <a class="btn btn-white btn-block" href={utm(POLYV_TRIAL, campaign, medium)} target="_blank" rel="noopener">{isEn ? SITE_EN.freeTrial : '免费开通保利威'}</a>
    <a class="btn btn-ghost-light btn-block" href={utm(POLYV_CONTACT, campaign, medium, POLYV_CONTACT_HASH)} target="_blank" rel="noopener">{isEn ? SITE_EN.contactAdvisor : '预约方案咨询'}</a>
    <p class="side-cta__phone">{isEn ? `${SITE_EN.footerPhone} ${POLYV_PHONE}` : `咨询电话 ${POLYV_PHONE}`}</p>
  </section>
  {toc.length > 0 && (
    <nav class="side-card side-toc" aria-label={isEn ? 'Table of contents' : '文章目录'}>
      <h3>{isEn ? 'Contents' : '目录'}</h3>
      <ol>{toc.filter((h) => h.depth === 2).map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
    </nav>
  )}
  <section class="side-card">
    <h3>{isEn ? 'Popular' : '热门文章'}</h3>
    <ol class="side-pop">
      {popular.map((a) => {
        const img = imagesFor(a.id);
        return (
          <li><a href={articlePath(a.id, locale)}>
            {img && <img src={img.cover.src800} alt="" width="96" height="54" loading="lazy" decoding="async" />}
            <span>{a.data.cardTitle ?? a.data.title}</span>
          </a></li>
        );
      })}
    </ol>
  </section>
  <section class="side-card">
    <h3>{isEn ? 'Popular tags' : '热门标签'}</h3>
    <div class="tags">{hotTags.map((t) => <a class="chip" href={`${searchBase}?q=${encodeURIComponent(t)}`}>{t}</a>)}</div>
  </section>
</aside>
