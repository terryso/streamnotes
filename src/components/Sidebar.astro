---
import { POLYV_TRIAL, POLYV_CONTACT, POLYV_CONTACT_HASH, POLYV_PHONE, utm } from '../consts';
import { getArticlesFor, imagesFor } from '../lib/articles';
import { ui, articlePath, pagePath, type Locale } from '../lib/i18n';
interface Props { campaign: string; medium?: string; toc?: { depth: number; slug: string; text: string }[]; exclude?: string; locale?: Locale }
const { campaign, medium = 'sidebar', toc = [], exclude, locale = 'zh' } = Astro.props;
const t = ui(locale);
const popular = (await getArticlesFor(locale)).filter((a) => a.id !== exclude).slice(0, 4);
const searchHref = pagePath('/search/', locale);
---
<aside class="sidebar">
  <section class="side-cta">
    <span class="eyebrow eyebrow--light">{t.sideEyebrow}</span>
    <h3>{t.sideTitle}</h3>
    <p>{t.sideBody}</p>
    <a class="btn btn-white btn-block" href={utm(POLYV_TRIAL, campaign, medium)} target="_blank" rel="noopener sponsored">{t.sideTrial}</a>
    <a class="btn btn-ghost-light btn-block" href={utm(POLYV_CONTACT, campaign, medium, POLYV_CONTACT_HASH)} target="_blank" rel="noopener sponsored">{t.sideContact}</a>
    <p class="side-cta__phone">{t.phone(POLYV_PHONE)}</p>
  </section>
  {toc.length > 0 && (
    <nav class="side-card side-toc" aria-label={t.tocAria}>
      <h3>{t.toc}</h3>
      <ol>{toc.filter((h) => h.depth === 2).map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
    </nav>
  )}
  <section class="side-card">
    <h3>{t.popular}</h3>
    <ol class="side-pop">
      {popular.map((a) => {
        const img = imagesFor(a.id);
        return (
          <li><a href={articlePath(a.id, locale)}>
            {img && <img src={img.cover.src800} alt="" width="96" height="54" loading="lazy" decoding="async" />}
            <span>{a.data.cardTitle ?? a.data.title}</span>
          </a></li>
        );
      })}
    </ol>
  </section>
  <section class="side-card">
    <h3>{t.tagsTitle}</h3>
    <div class="tags">{t.hotTags.map((tag) => <a class="chip" href={`${searchHref}?q=${encodeURIComponent(tag)}`}>{tag}</a>)}</div>
  </section>
</aside>
