---
import { SITE_NAME, SITE_NAME_EN, CATEGORIES, GA4_ID, GSC_VERIFICATION, POLYV_TRIAL, POLYV_CONTACT, POLYV_CONTACT_HASH, POLYV_PHONE, utm } from '../consts';
import { ui, categoryLabel, homePath, categoryPath, pagePath, twinPath, type Locale } from '../lib/i18n';
import Icon from '../components/Icon.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
  jsonLd?: object[];
  campaign?: string;
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  preloadImage?: string;
  active?: string;
  locale?: Locale;
  /** Override the twin page in the other locale (defaults to the mirrored path). */
  zhPath?: string;
  enPath?: string;
  /** True when this page has no twin in the other locale (switcher falls back to the other home). */
  noTwin?: boolean;
}
const noTwin = Astro.props.noTwin ?? false;
const { title, description, ogType = 'website', ogImage = '/og-default.png', ogImageAlt, jsonLd = [], campaign = 'site', publishedTime, modifiedTime, noindex = false, preloadImage, active, locale = 'zh' } = Astro.props;
const t = ui(locale);
const isEn = locale === 'en';
const desc = description ?? t.description;
const fullTitle = title ? `${title} | ${t.siteName}` : `${t.siteName} - ${t.tagline}`;
const path = Astro.url.pathname;
const twins = twinPath(path);
const zhPath = Astro.props.zhPath ?? twins.zh;
const enPath = Astro.props.enPath ?? twins.en;
const zhUrl = new URL(zhPath, Astro.site).toString();
const enUrl = new URL(enPath, Astro.site).toString();
const selfUrl = new URL(path, Astro.site).toString();
const canonical = noTwin ? selfUrl : (isEn ? enUrl : zhUrl);
const switchHref = isEn ? zhPath : enPath;
const ogImageUrl = new URL(ogImage, Astro.site).toString();
const siteUrl = Astro.site!.toString();
const home = homePath(locale);
const aboutHref = pagePath('/about/', locale);
const searchHref = pagePath('/search/', locale);
const rssHref = pagePath('/rss.xml', locale);
const baseLd = [
  { '@context': 'https://schema.org', '@type': 'Organization', '@id': siteUrl + '#org', name: SITE_NAME, alternateName: SITE_NAME_EN, url: siteUrl, logo: new URL('/logo.png', Astro.site).toString() },
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': new URL(home, Astro.site).toString() + '#website', name: t.siteName, alternateName: t.siteNameAlt, url: new URL(home, Astro.site).toString(), inLanguage: t.htmlLang, description: t.description, publisher: { '@id': siteUrl + '#org' },
    potentialAction: { '@type': 'SearchAction', target: { '@type': 'EntryPoint', urlTemplate: new URL(searchHref, Astro.site).toString() + '?q={search_term_string}' }, 'query-input': 'required name=search_term_string' } },
];
const allLd = [...baseLd, ...jsonLd];
const isActive = (p: string) => (p === home ? path === home : path.startsWith(p)) || active === p;
const catKeys = Object.keys(CATEGORIES) as (keyof typeof CATEGORIES)[];
---
<!doctype html>
<html lang={t.htmlLang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={canonical} />
  {!noindex && !noTwin && <link rel="alternate" hreflang="zh-CN" href={zhUrl} />}
  {!noindex && !noTwin && <link rel="alternate" hreflang="en" href={enUrl} />}
  {!noindex && !noTwin && <link rel="alternate" hreflang="x-default" href={zhUrl} />}
  {!noindex && noTwin && <link rel="alternate" hreflang={t.htmlLang} href={selfUrl} />}
  <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'} />
  <meta property="og:site_name" content={t.siteName} />
  <meta property="og:locale" content={t.ogLocale} />
  <meta property="og:locale:alternate" content={isEn ? 'zh_CN' : 'en_US'} />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title ?? t.siteName} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}
  {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title ?? t.siteName} />
  <meta name="twitter:description" content={desc} />
  <meta name="twitter:image" content={ogImageUrl} />
  <meta name="theme-color" content="#0b1220" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title={t.siteName} href={rssHref} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
  {GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}
  {allLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  {GA4_ID && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
      <script is:inline define:vars={{ GA4_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', GA4_ID);
        var CTA_ZONES = [['.site-header','header'],['.hero','hero'],['.leadband','leadband'],['.cta-inline','article_mid'],['.cta-end','article_end'],['.side-cta','sidebar'],['.site-footer','footer'],['.tabbar','tabbar']];
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a[href]');
          if (!a) return;
          for (var i = 0; i < CTA_ZONES.length; i++) {
            if (a.closest(CTA_ZONES[i][0]) && (a.classList.contains('btn') || CTA_ZONES[i][1] !== 'header')) {
              gtag('event', 'cta_click', { location: CTA_ZONES[i][1], link_url: a.href, link_text: (a.textContent || '').trim().slice(0, 60), page_path: location.pathname });
              return;
            }
          }
        });
      </script>
    </>
  )}
</head>
<body>
  <a class="skip" href="#main">{t.skip}</a>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href={home} aria-label={t.homeAria(t.siteName)}>
        <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></span>
        <span class="brand-name">{t.siteName}</span>
        <span class="brand-en" lang={isEn ? 'zh-CN' : 'en'}>{t.siteNameAlt}</span>
      </a>
      <nav class="mainnav" aria-label={t.navMain}>
        <ul>
          <li><a href={home} aria-current={path === home ? 'page' : undefined}>{t.navHome}</a></li>
          {catKeys.map((k) => <li><a href={categoryPath(k, locale)} aria-current={isActive(categoryPath(k, locale)) ? 'page' : undefined}>{categoryLabel(k, locale).name}</a></li>)}
          <li><a href={aboutHref} aria-current={isActive(aboutHref) ? 'page' : undefined}>{t.navAbout}</a></li>
        </ul>
      </nav>
      <div class="header-actions">
        <form class="hsearch" action={searchHref} method="get" role="search">
          <label class="sr-only" for="hsearch-q">{t.searchLabel}</label>
          <Icon name="search" size={16} />
          <input id="hsearch-q" name="q" type="search" placeholder={t.searchPlaceholder} autocomplete="off" />
        </form>
        <a class="lang-switch" href={switchHref} hreflang={t.switchHreflang} lang={t.switchLang} aria-label={t.switchAria} data-lang-switch>{t.switchLabel}</a>
        <a class="btn btn-primary btn-sm header-cta" href={utm(POLYV_TRIAL, campaign, 'header')} target="_blank" rel="noopener sponsored">{t.headerTrial}</a>
      </div>
    </div>
    <nav class="subnav" aria-label={t.navTopics}>
      <div class="subnav__scroll">
        <a href={home} aria-current={path === home ? 'page' : undefined}>{t.navFeatured}</a>
        {catKeys.map((k) => <a href={categoryPath(k, locale)} aria-current={isActive(categoryPath(k, locale)) ? 'page' : undefined}>{categoryLabel(k, locale).name}</a>)}
        <a href={aboutHref} aria-current={isActive(aboutHref) ? 'page' : undefined}>{t.navAbout}</a>
        <a class="subnav__lang" href={switchHref} hreflang={t.switchHreflang} lang={t.switchLang}>{t.switchLabel}</a>
      </div>
    </nav>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container footer-grid">
      <section class="footer-brand">
        <a class="brand brand--light" href={home}><span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></span><span class="brand-name">{t.siteName}</span></a>
        <p>{t.description}</p>
        <p class="footer-links-inline"><a href={rssHref}>RSS</a><a href="/llms.txt">llms.txt</a><a href={switchHref} hreflang={t.switchHreflang} lang={t.switchLang}>{t.switchLabel}</a></p>
      </section>
      <section>
        <h2 class="footer-h">{t.footerTopics}</h2>
        <ul>{catKeys.map((k) => <li><a href={categoryPath(k, locale)}>{categoryLabel(k, locale).name}</a></li>)}</ul>
      </section>
      <section>
        <h2 class="footer-h">{t.footerHot}</h2>
        <ul>{t.hotTags.slice(0, 5).map((tag) => <li><a href={`${searchHref}?q=${encodeURIComponent(tag)}`}>{tag}</a></li>)}</ul>
      </section>
      <section>
        <h2 class="footer-h">{t.footerSolutions}</h2>
        <ul>
          <li><a href={utm(POLYV_TRIAL, campaign, 'footer')} target="_blank" rel="noopener sponsored">{t.footerTrial}</a></li>
          <li><a href={utm(POLYV_CONTACT, campaign, 'footer', POLYV_CONTACT_HASH)} target="_blank" rel="noopener sponsored">{t.footerContact}</a></li>
          <li>{t.phone(POLYV_PHONE)}</li>
        </ul>
      </section>
      <section>
        <h2 class="footer-h">{t.footerAbout}</h2>
        <ul>
          <li><a href={aboutHref}>{t.footerAboutSite}</a></li>
          <li><a href={pagePath('/credits/', locale)}>{t.footerCredits}</a></li>
          <li><a href={searchHref}>{t.footerSearch}</a></li>
        </ul>
      </section>
    </div>
    <div class="container footer-bottom">{t.footerCopy(new Date().getFullYear(), t.siteName)}</div>
  </footer>

  <nav class="tabbar" aria-label={t.navQuick}>
    <a href={home} aria-current={path === home ? 'page' : undefined}><Icon name="home" /><span>{t.tabHome}</span></a>
    <a href={categoryPath('tutorial', locale)} aria-current={path.includes('/category/') ? 'page' : undefined}><Icon name="grid" /><span>{t.tabTopics}</span></a>
    <a href={searchHref} aria-current={path.includes('/search/') ? 'page' : undefined}><Icon name="search" /><span>{t.tabSearch}</span></a>
    <a href={utm(POLYV_CONTACT, campaign, 'tabbar', POLYV_CONTACT_HASH)} target="_blank" rel="noopener sponsored" class="tabbar__cta"><Icon name="chat" /><span>{t.tabConsult}</span></a>
  </nav>
</body>
</html>
