---
import { SITE_NAME, SITE_NAME_EN, SITE_DESCRIPTION, SITE_TAGLINE, CATEGORIES, GA4_ID, GSC_VERIFICATION, POLYV_TRIAL, POLYV_CONTACT, POLYV_CONTACT_HASH, utm } from '../consts';
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  jsonLd?: object[];
  campaign?: string;
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
}
const { title, description = SITE_DESCRIPTION, ogType = 'website', jsonLd = [], campaign = 'site', publishedTime, modifiedTime, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE_NAME}` : `${SITE_NAME} - ${SITE_TAGLINE}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL('/og-default.png', Astro.site).toString();
const siteUrl = Astro.site!.toString();
const baseLd = [
  { '@context': 'https://schema.org', '@type': 'Organization', '@id': siteUrl + '#org', name: SITE_NAME, alternateName: SITE_NAME_EN, url: siteUrl, logo: new URL('/logo.png', Astro.site).toString() },
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': siteUrl + '#website', name: SITE_NAME, url: siteUrl, inLanguage: 'zh-CN', description: SITE_DESCRIPTION, publisher: { '@id': siteUrl + '#org' } },
];
const allLd = [...baseLd, ...jsonLd];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="zh-CN" href={canonical} />
  <link rel="alternate" hreflang="x-default" href={canonical} />
  <meta name="robots" content={noindex ? "noindex,follow" : "index,follow,max-image-preview:large"} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content="zh_CN" />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title ?? SITE_NAME} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}
  {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title ?? SITE_NAME} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="theme-color" content="#0f5bd8" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  {GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}
  {allLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  {GA4_ID && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
      <script is:inline define:vars={{ GA4_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', GA4_ID);
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a[href*="polyv.net"]');
          if (a) gtag('event', 'cta_click', { link_url: a.href, page_path: location.pathname });
        });
      </script>
    </>
  )}
</head>
<body>
  <a class="skip" href="#main">跳到正文</a>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/" aria-label={`${SITE_NAME} 首页`}>
        <span class="brand-mark" aria-hidden="true">▶</span>
        <span class="brand-name">{SITE_NAME}</span>
        <span class="brand-en">{SITE_NAME_EN}</span>
      </a>
      <nav aria-label="主导航">
        <ul class="nav">
          {Object.entries(CATEGORIES).map(([k, c]) => (
            <li><a href={`/category/${k}/`} aria-current={path.startsWith(`/category/${k}/`) ? 'page' : undefined}>{c.name}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </header>
  <main id="main" class="container">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="container footer-grid">
      <section>
        <p class="footer-brand">{SITE_NAME} · {SITE_NAME_EN}</p>
        <p>{SITE_DESCRIPTION}</p>
      </section>
      <section>
        <h2 class="footer-h">栏目</h2>
        <ul>{Object.entries(CATEGORIES).map(([k, c]) => <li><a href={`/category/${k}/`}>{c.name}</a></li>)}</ul>
      </section>
      <section>
        <h2 class="footer-h">企业视频方案</h2>
        <ul>
          <li><a href={utm(POLYV_TRIAL, campaign, 'footer')} target="_blank" rel="noopener sponsored">免费开通保利威直播/点播</a></li>
          <li><a href={utm(POLYV_CONTACT, campaign, 'footer', POLYV_CONTACT_HASH)} target="_blank" rel="noopener sponsored">联系保利威方案顾问</a></li>
          <li><a href="/about/">关于本站</a></li>
          <li><a href="/rss.xml">RSS</a> · <a href="/sitemap-index.xml">Sitemap</a> · <a href="/llms.txt">llms.txt</a></li>
        </ul>
      </section>
    </div>
    <div class="container footer-bottom">© {new Date().getFullYear()} {SITE_NAME}。本站内容由保利威（POLYV）支持，文中涉及保利威的推荐内容已标注。</div>
  </footer>
</body>
</html>
