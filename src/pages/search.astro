---
import Base from '../layouts/Base.astro';
import { HOT_TAGS } from '../consts';
---
<Base title="站内搜索" description="搜索流媒笔记的直播、点播、选型与行业实践文章。" campaign="search" noindex>
  <section class="pagehead">
    <div class="container">
      <h1>站内搜索</h1>
      <form class="bigsearch" action="/search/" method="get" role="search">
        <label class="sr-only" for="q">关键词</label>
        <input id="q" name="q" type="search" placeholder="输入关键词，例如：低延迟、私有化、企业培训" autocomplete="off" />
        <button class="btn btn-primary" type="submit">搜索</button>
      </form>
      <div class="tags">{HOT_TAGS.map((t) => <a class="chip" href={`/search/?q=${encodeURIComponent(t)}`}>{t}</a>)}</div>
    </div>
  </section>
  <section class="section container">
    <p id="status" class="search-status" aria-live="polite"></p>
    <div id="results" class="alist"></div>
  </section>
  <script is:inline>
    (function () {
      var q = new URLSearchParams(location.search).get('q') || '';
      var input = document.getElementById('q'); input.value = q;
      var status = document.getElementById('status'), box = document.getElementById('results');
      function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
      function run(data, q) {
        var terms = q.toLowerCase().split(/\s+/).filter(Boolean);
        var res = data.map(function (a) {
          var hay = (a.t + ' ' + a.d + ' ' + a.g.join(' ') + ' ' + a.c).toLowerCase(), body = a.k.toLowerCase(), s = 0;
          terms.forEach(function (t) { if (hay.indexOf(t) >= 0) s += 3; if (body.indexOf(t) >= 0) s += 1; if (hay.indexOf(t) < 0 && body.indexOf(t) < 0) s -= 100; });
          return { a: a, s: s };
        }).filter(function (x) { return !terms.length || x.s > 0; }).sort(function (x, y) { return y.s - x.s; });
        status.textContent = terms.length ? ('“' + q + '” 共找到 ' + res.length + ' 篇文章') : ('全部文章 ' + res.length + ' 篇');
        box.innerHTML = res.map(function (x) { var a = x.a; return '<article class="arow"><a class="arow__media" href="' + a.u + '" tabindex="-1" aria-hidden="true">' + (a.i ? '<img src="' + a.i + '" alt="" width="800" height="450" loading="lazy">' : '') + '</a><div class="arow__body"><div class="meta"><span class="tag">' + esc(a.c) + '</span></div><h2 class="arow__title"><a href="' + a.u + '">' + esc(a.t) + '</a></h2><p class="arow__desc">' + esc(a.d) + '</p></div></article>'; }).join('');
      }
      fetch('/search.json').then(function (r) { return r.json(); }).then(function (d) { run(d, q); });
    })();
  </script>
</Base>
