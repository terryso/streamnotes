---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Sidebar from '../../components/Sidebar.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { CATEGORIES } from '../../consts';
export function getStaticPaths() {
  return Object.keys(CATEGORIES).map((cat) => ({ params: { cat } }));
}
const { cat } = Astro.params as { cat: keyof typeof CATEGORIES };
const c = CATEGORIES[cat];
const posts = (await getCollection('articles', (e) => !e.data.draft && e.data.category === cat)).sort((a, b) => +b.data.pubDate - +a.data.pubDate);
const site = Astro.site!.toString();
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: site },
    { '@type': 'ListItem', position: 2, name: c.name, item: new URL(`/category/${cat}/`, Astro.site).toString() },
  ] },
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: c.name, description: c.desc, inLanguage: 'zh-CN' },
];
---
<Base title={c.name} description={c.desc} jsonLd={jsonLd} campaign={`category-${cat}`}>
  <div class="layout">
    <section>
      <nav class="breadcrumb" aria-label="面包屑"><ol><li><a href="/">首页</a></li><li aria-current="page">{c.name}</li></ol></nav>
      <h1 style="margin:4px 0 4px">{c.name}</h1>
      <p style="color:var(--c-muted);margin-top:0">{c.desc}</p>
      <div class="card-list">
        {posts.length ? posts.map((p) => <ArticleCard entry={p} />) : <p>本栏目文章即将上线。</p>}
      </div>
    </section>
    <Sidebar campaign={`category-${cat}`} />
  </div>
</Base>
