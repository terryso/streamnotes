---
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';
import ArticleCard from '../components/ArticleCard.astro';
import LeadBand from '../components/LeadBand.astro';
import Icon from '../components/Icon.astro';
import { SITE_NAME, SITE_TAGLINE, CATEGORIES, SCENARIOS, HOT_TAGS, CHECKLIST_URL } from '../consts';
import { getArticles, imagesFor, siteImages } from '../lib/articles';
const posts = await getArticles();
const latest = posts.slice(0, 4);
const hero = siteImages.hero;
const band = siteImages.band;
const counts = Object.fromEntries(Object.keys(CATEGORIES).map((k) => [k, posts.filter((p) => p.data.category === k).length]));
---
<Base campaign="home" preloadImage={hero.src900}>
  <section class="hero">
    <picture class="hero__bg">
      <source media="(max-width: 700px)" srcset={hero.src900} />
      <img src={hero.src} alt={hero.alt} width={hero.w} height={hero.h} fetchpriority="high" decoding="async" />
    </picture>
    <div class="container hero__inner">
      <span class="eyebrow eyebrow--light">企业直播 · 视频点播 · 技术选型</span>
      <h1>{SITE_NAME}：{SITE_TAGLINE}</h1>
      <p>面向企业技术与业务团队的直播点播知识库——协议与延迟、视频加密、平台选型、企业培训与营销直播实践，讲清原理，也给出可落地的清单。</p>
      <div class="hero__actions">
        <a class="btn btn-primary btn-lg" href="#all">浏览全部文章 <Icon name="arrow" size={18} /></a>
        <a class="btn btn-ghost-light btn-lg" href={CHECKLIST_URL}>查看选型清单</a>
      </div>
      <ul class="hero__stats" aria-label="栏目">
        {Object.entries(CATEGORIES).map(([k, c]) => <li><a href={`/category/${k}/`}><strong>{counts[k]}</strong><span>{c.name}</span></a></li>)}
      </ul>
    </div>
  </section>

  <section class="section container" aria-labelledby="latest-h">
    <div class="section-head">
      <h2 id="latest-h">最新文章</h2>
      <a class="more" href="#all">查看全部 <Icon name="arrow" size={16} /></a>
    </div>
    <div class="grid4">{latest.map((p, i) => <ArticleCard entry={p} eager={i < 2} />)}</div>
  </section>

  <section class="caseband" aria-labelledby="case-h">
    <img class="caseband__bg" src={band.src} alt="" width={band.w} height={band.h} loading="lazy" decoding="async" />
    <div class="container">
      <div class="section-head section-head--light">
        <div>
          <span class="eyebrow eyebrow--light">深度案例库</span>
          <h2 id="case-h">按场景找答案</h2>
        </div>
        <p class="caseband__lead">围绕企业最常见的四类视频场景，整理原理、方法与选型清单。</p>
      </div>
      <div class="casegrid">
        {SCENARIOS.map((s) => {
          const img = imagesFor(s.image);
          return (
            <a class="casecard" href={s.href}>
              {img && <img src={img.cover.src800} alt="" width="800" height="450" loading="lazy" decoding="async" />}
              <span class="casecard__shade" />
              <span class="casecard__text"><strong>{s.name}</strong><span>{s.desc}</span></span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section container" aria-labelledby="tags-h">
    <div class="section-head"><h2 id="tags-h">热门标签</h2></div>
    <div class="tags tags--lg">{HOT_TAGS.map((t) => <a class="chip chip--lg" href={`/search/?q=${encodeURIComponent(t)}`}># {t}</a>)}</div>
  </section>

  <LeadBand campaign="home" />

  <section class="section container" id="all" aria-labelledby="all-h">
    <div class="layout">
      <div>
        <div class="section-head">
          <h2 id="all-h">全部文章</h2>
        </div>
        <div class="tabs" role="tablist" aria-label="按栏目筛选">
          <button type="button" role="tab" aria-selected="true" data-filter="all">全部</button>
          {Object.entries(CATEGORIES).map(([k, c]) => <button type="button" role="tab" aria-selected="false" data-filter={k}>{c.name}</button>)}
        </div>
        <div class="alist" id="alist">{posts.map((p) => <ArticleCard entry={p} variant="row" />)}</div>
        <noscript><p>按栏目浏览：{Object.entries(CATEGORIES).map(([k, c]) => <a href={`/category/${k}/`}>{c.name} </a>)}</p></noscript>
      </div>
      <Sidebar campaign="home" />
    </div>
  </section>
  <script is:inline>
    (function () {
      var tabs = document.querySelectorAll('.tabs [data-filter]');
      var rows = document.querySelectorAll('#alist .arow');
      tabs.forEach(function (t) {
        t.addEventListener('click', function () {
          var f = t.getAttribute('data-filter');
          tabs.forEach(function (x) { x.setAttribute('aria-selected', x === t ? 'true' : 'false'); });
          rows.forEach(function (r) { r.hidden = !(f === 'all' || r.getAttribute('data-category') === f); });
        });
      });
    })();
  </script>
</Base>
