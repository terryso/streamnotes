---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import Sidebar from '../../components/Sidebar.astro';
import { CATEGORIES, SITE_NAME } from '../../consts';

export async function getStaticPaths() {
  const all = (await getCollection('articles', (e) => !e.data.draft)).sort((a, b) => +b.data.pubDate - +a.data.pubDate);
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry, all } }));
}
const { entry, all } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const cat = CATEGORIES[d.category];
const site = Astro.site!.toString();
const url = new URL(`/articles/${entry.id}/`, Astro.site).toString();
const fmt = (x: Date) => x.toISOString().slice(0, 10);
const relatedIds = d.related.length ? d.related : [];
let related = relatedIds.map((id) => all.find((a) => a.id === id)).filter(Boolean) as typeof all;
for (const a of all) { if (related.length >= 4) break; if (a.id !== entry.id && !related.includes(a) && a.data.category === d.category) related.push(a); }
for (const a of all) { if (related.length >= 4) break; if (a.id !== entry.id && !related.includes(a)) related.push(a); }
const jsonLd: object[] = [
  {
    '@context': 'https://schema.org', '@type': 'Article', headline: d.title, description: d.description,
    datePublished: d.pubDate.toISOString(), dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
    inLanguage: 'zh-CN', mainEntityOfPage: url, url, image: new URL('/og-default.png', Astro.site).toString(),
    articleSection: cat.name, keywords: d.tags.join(','),
    author: { '@type': 'Organization', name: `${SITE_NAME}编辑部`, url: site },
    publisher: { '@id': site + '#org' },
    citation: d.sources.map((s) => ({ '@type': 'CreativeWork', name: s.title, url: s.url })),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: site },
      { '@type': 'ListItem', position: 2, name: cat.name, item: new URL(`/category/${d.category}/`, Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
if (d.faq.length) jsonLd.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
---
<Base title={d.title} description={d.description} ogType="article" jsonLd={jsonLd} campaign={entry.id} publishedTime={d.pubDate.toISOString()} modifiedTime={(d.updatedDate ?? d.pubDate).toISOString()}>
  <div class="layout">
    <article class="article">
      <nav class="breadcrumb" aria-label="面包屑">
        <ol><li><a href="/">首页</a></li><li><a href={`/category/${d.category}/`}>{cat.name}</a></li><li aria-current="page">正文</li></ol>
      </nav>
      <header>
        <h1>{d.title}</h1>
        <div class="meta">
          <a class="tag" href={`/category/${d.category}/`}>{cat.name}</a>
          <time datetime={d.pubDate.toISOString()}>发布于 {fmt(d.pubDate)}</time>
          {d.updatedDate && <time datetime={d.updatedDate.toISOString()}>更新于 {fmt(d.updatedDate)}</time>}
          {d.promo && <span class="tag tag-promo">合作推荐</span>}
        </div>
        {d.promo && <p class="promo-note">说明：本文包含对保利威（POLYV）产品的推荐，产品信息均来自其官网公开资料，建议以官方最新说明为准。</p>}
      </header>
      <section class="tldr" aria-label="要点速览">
        <h2>TL;DR 要点速览</h2>
        <ul>{d.tldr.map((t) => <li>{t}</li>)}</ul>
      </section>
      <Content />
      <Cta campaign={entry.id} />
      {d.faq.length > 0 && (
        <section class="faq">
          <h2>常见问题（FAQ）</h2>
          {d.faq.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
        </section>
      )}
      {d.sources.length > 0 && (
        <section class="sources">
          <h2>参考资料</h2>
          <ol>{d.sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.title}</a></li>)}</ol>
        </section>
      )}
      <section class="related">
        <h2>相关阅读</h2>
        <ul>{related.map((a) => <li><a href={`/articles/${a.id}/`}>{a.data.title}</a></li>)}</ul>
      </section>
    </article>
    <Sidebar campaign={entry.id} />
  </div>
</Base>
