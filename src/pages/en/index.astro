---
import Base from '../../layouts/Base.astro';
import Sidebar from '../../components/Sidebar.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import LeadBand from '../../components/LeadBand.astro';
import Icon from '../../components/Icon.astro';
import { CATEGORIES } from '../../consts';
import { SITE_EN, categoryLabel, categoryPath } from '../../lib/i18n';
import { getArticlesEn } from '../../lib/articles';

const posts = await getArticlesEn();
const latest = posts.slice(0, 4);
const catKeys = Object.keys(CATEGORIES) as (keyof typeof CATEGORIES)[];
const counts = Object.fromEntries(catKeys.map((k) => [k, posts.filter((p) => p.data.category === k).length]));
---
<Base locale="en" campaign="en-home" title={SITE_EN.name} description={SITE_EN.description} hreflangZh="/" hreflangEn="/en/">
  <section class="hero hero--compact">
    <div class="container hero__inner">
      <span class="eyebrow eyebrow--light">{SITE_EN.homeEyebrow}</span>
      <h1>{SITE_EN.name}: {SITE_EN.tagline}</h1>
      <p>{SITE_EN.homeLead}</p>
      <p class="en-note">{SITE_EN.enEditionNote} — Chinese remains the default site. New articles should ship with an English twin when practical.</p>
      <div class="hero__actions">
        <a class="btn btn-primary btn-lg" href="#all">{SITE_EN.browseAll} <Icon name="arrow" size={18} /></a>
        <a class="btn btn-ghost-light btn-lg" href="/" hreflang="zh-CN" lang="zh-CN">中文站</a>
      </div>
      <ul class="hero__stats" aria-label="Topics">
        {catKeys.map((k) => (
          <li><a href={categoryPath(k, 'en')}><strong>{counts[k]}</strong><span>{categoryLabel(k, 'en').name}</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  {latest.length > 0 && (
    <section class="section container" aria-labelledby="latest-h">
      <div class="section-head">
        <h2 id="latest-h">{SITE_EN.latest}</h2>
        <a class="more" href="#all">{SITE_EN.viewAll} <Icon name="arrow" size={16} /></a>
      </div>
      <div class="grid4">{latest.map((p, i) => <ArticleCard entry={p} locale="en" eager={i < 2} />)}</div>
    </section>
  )}

  <LeadBand campaign="en-home" locale="en" />

  <section class="section container" id="all" aria-labelledby="all-h">
    <div class="layout">
      <div>
        <div class="section-head"><h2 id="all-h">{SITE_EN.allArticles}</h2></div>
        <div class="alist" id="alist">
          {posts.length
            ? posts.map((p) => <ArticleCard entry={p} variant="row" locale="en" />)
            : <p class="empty">{SITE_EN.emptyCategory}</p>}
        </div>
      </div>
      <Sidebar campaign="en-home" locale="en" />
    </div>
  </section>
</Base>
