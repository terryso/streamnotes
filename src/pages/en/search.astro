---
import Base from '../../layouts/Base.astro';
import { SITE_EN } from '../../lib/i18n';
---
<Base locale="en" title="Search" description="Search StreamNotes English articles" noindex={true} campaign="en-search" hreflangZh="/search/" hreflangEn="/en/search/">
  <section class="pagehead">
    <div class="container">
      <h1>Search</h1>
      <p>Search English-edition articles. For the full Chinese index, use <a href="/search/">/search/</a>.</p>
    </div>
  </section>
  <section class="section container">
    <form class="search-form" action="/en/search/" method="get" role="search">
      <label class="sr-only" for="q">{SITE_EN.searchLabel}</label>
      <input id="q" name="q" type="search" placeholder={SITE_EN.searchPlaceholder} value={Astro.url.searchParams.get('q') || ''} />
      <button class="btn btn-primary" type="submit">Search</button>
    </form>
    <div id="results" class="alist" style="margin-top:1.5rem"></div>
  </section>
  <script is:inline>
    (function () {
      var q = new URLSearchParams(location.search).get('q') || '';
      var box = document.getElementById('results');
      if (!box) return;
      fetch('/search.json').then(function (r) { return r.json(); }).then(function (all) {
        var en = all.filter(function (a) { return a.lang === 'en'; });
        var terms = q.trim().toLowerCase().split(/\s+/).filter(Boolean);
        if (!terms.length) { box.innerHTML = '<p class="empty">Type a keyword to search.</p>'; return; }
        var hits = en.filter(function (a) {
          var hay = ((a.t || '') + ' ' + (a.d || '') + ' ' + (a.g || []).join(' ') + ' ' + (a.k || '')).toLowerCase();
          return terms.every(function (t) { return hay.indexOf(t) !== -1; });
        }).slice(0, 30);
        if (!hits.length) { box.innerHTML = '<p class="empty">No matches.</p>'; return; }
        box.innerHTML = hits.map(function (a) {
          return '<article class="arow"><div class="arow__body"><h3 class="arow__title"><a href="' + a.u + '">' + (a.t || '') + '</a></h3><p class="arow__desc">' + (a.d || '') + '</p></div></article>';
        }).join('');
      }).catch(function () { box.innerHTML = '<p class="empty">Search index unavailable.</p>'; });
    })();
  </script>
</Base>
