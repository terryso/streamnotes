---
import ArticlePage from '../../../components/pages/ArticlePage.astro';
import { getArticlesFor } from '../../../lib/articles';
export async function getStaticPaths() {
  const all = await getArticlesFor('en');
  return all.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, all, newer: all[i - 1] ?? null, older: all[i + 1] ?? null } }));
}
const { entry, all, newer, older } = Astro.props;
---
<ArticlePage entry={entry} all={all} newer={newer} older={older} locale="en" />
