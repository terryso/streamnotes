---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Cta from '../../../components/Cta.astro';
import Sidebar from '../../../components/Sidebar.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import Icon from '../../../components/Icon.astro';
import { getArticlesEn, hasZhTwin, imagesFor, readingMinutes, fmtDate, coverAlt } from '../../../lib/articles';
import { SITE_EN, categoryLabel, articlePath, categoryPath, homePath } from '../../../lib/i18n';

export async function getStaticPaths() {
  const all = await getArticlesEn();
  return all.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, all, newer: all[i - 1] ?? null, older: all[i + 1] ?? null } }));
}
const { entry, all, newer, older } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const cat = categoryLabel(d.category, 'en');
const site = Astro.site!.toString();
const url = new URL(articlePath(entry.id, 'en'), Astro.site).toString();
const zhExists = await hasZhTwin(entry.id);
const zhUrl = zhExists ? articlePath(entry.id, 'zh') : undefined;
const img = imagesFor(entry.id);
const mins = readingMinutes(entry.body);
let related = d.related.map((id) => all.find((a) => a.id === id)).filter(Boolean) as typeof all;
for (const a of all) { if (related.length >= 3) break; if (a.id !== entry.id && !related.includes(a) && a.data.category === d.category) related.push(a); }
for (const a of all) { if (related.length >= 3) break; if (a.id !== entry.id && !related.includes(a)) related.push(a); }
related = related.slice(0, 3);
const imageUrls = img ? [new URL(img.og, Astro.site).toString(), new URL(img.cover.src, Astro.site).toString()] : [new URL('/og-default.png', Astro.site).toString()];
const jsonLd: object[] = [
  {
    '@context': 'https://schema.org', '@type': 'Article', headline: d.title, description: d.description,
    datePublished: d.pubDate.toISOString(), dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
    inLanguage: 'en', mainEntityOfPage: url, url, image: imageUrls,
    articleSection: cat.name, keywords: d.tags.join(','), timeRequired: `PT${mins}M`,
    author: { '@type': 'Organization', name: SITE_EN.author, url: site },
    publisher: { '@id': site + '#org' },
    citation: d.sources.map((s) => ({ '@type': 'CreativeWork', name: s.title, url: s.url })),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE_EN.breadcrumbHome, item: new URL(homePath('en'), Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: cat.name, item: new URL(categoryPath(d.category, 'en'), Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
if (d.faq.length) jsonLd.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
const c = img?.cover.credit;
const alt = coverAlt(entry.id, 'en');
---
<Base title={d.title} description={d.description} ogType="article" ogImage={img?.og} ogImageAlt={alt} jsonLd={jsonLd} campaign={`en-${entry.id}`}
  publishedTime={d.pubDate.toISOString()} modifiedTime={(d.updatedDate ?? d.pubDate).toISOString()} preloadImage={img?.cover.src800} active={categoryPath(d.category, 'en')}
  locale="en" hreflangZh={zhUrl} hreflangEn={articlePath(entry.id, 'en')}>
  <article class="post">
    <header class="post-head container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href={homePath('en')}>{SITE_EN.breadcrumbHome}</a></li>
          <li><a href={categoryPath(d.category, 'en')}>{cat.name}</a></li>
          <li aria-current="page">{SITE_EN.breadcrumbArticle}</li>
        </ol>
      </nav>
      <div class="meta">
        <a class="tag" href={categoryPath(d.category, 'en')}>{cat.name}</a>
        {zhExists && <a class="lang-chip" href={zhUrl} hreflang="zh-CN" lang="zh-CN">{SITE_EN.langSwitchToZh}</a>}
      </div>
      <h1>{d.title}</h1>
      <p class="post-lead">{d.description}</p>
      <div class="byline">
        <span class="avatar" aria-hidden="true">SN</span>
        <span class="byline__who"><strong>{SITE_EN.author}</strong>
          <span class="meta meta--muted">
            <time datetime={d.pubDate.toISOString()}>{fmtDate(d.pubDate)}</time>
            {d.updatedDate && <><span class="dot">·</span><span>{SITE_EN.updated} {fmtDate(d.updatedDate)}</span></>}
            <span class="dot">·</span><span><Icon name="clock" size={14} /> {SITE_EN.readingMins(mins)}</span>
          </span>
        </span>
      </div>
    </header>
    <div class="container layout layout--post">
      <div class="post-main">
        {img && (
          <figure class="post-cover">
            <picture>
              <source media="(max-width: 700px)" srcset={img.cover.src800} />
              <img src={img.cover.src} alt={alt} width={img.cover.w} height={img.cover.h} fetchpriority="high" decoding="async" />
            </picture>
            <figcaption><span class="credit">{SITE_EN.coverCredit} {c?.landing ? <a href={c.landing} target="_blank" rel="noopener nofollow">{c.creator}</a> : c?.creator} · {c?.license}</span></figcaption>
          </figure>
        )}
        <section class="tldr" aria-label="TL;DR">
          <h2>{SITE_EN.tldr}</h2>
          <ul>{d.tldr.map((t) => <li>{t}</li>)}</ul>
        </section>
        <div class="prose"><Content /></div>
        <Cta campaign={`en-${entry.id}`} locale="en" />
        {d.faq.length > 0 && (
          <section class="faq">
            <h2>{SITE_EN.faq}</h2>
            {d.faq.map((f, i) => (<details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>))}
          </section>
        )}
        {d.sources.length > 0 && (
          <section class="sources">
            <h2>{SITE_EN.sources}</h2>
            <ol>{d.sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.title}</a></li>)}</ol>
          </section>
        )}
        <div class="post-tags">{d.tags.map((t) => <a class="chip" href={`/en/search/?q=${encodeURIComponent(t)}`}># {t}</a>)}</div>
        <nav class="prevnext" aria-label="Previous and next">
          {older ? <a class="prevnext__item" href={articlePath(older.id, 'en')} rel="prev"><span>{SITE_EN.prev}</span><strong>{older.data.cardTitle ?? older.data.title}</strong></a> : <span />}
          {newer ? <a class="prevnext__item prevnext__item--next" href={articlePath(newer.id, 'en')} rel="next"><span>{SITE_EN.next}</span><strong>{newer.data.cardTitle ?? newer.data.title}</strong></a> : <span />}
        </nav>
      </div>
      <Sidebar campaign={`en-${entry.id}`} toc={headings} exclude={entry.id} locale="en" />
    </div>
    {related.length > 0 && (
      <section class="section container related" aria-labelledby="rel-h">
        <div class="section-head"><h2 id="rel-h">{SITE_EN.related}</h2></div>
        <div class="grid3">{related.map((a) => <ArticleCard entry={a} locale="en" />)}</div>
      </section>
    )}
  </article>
</Base>
