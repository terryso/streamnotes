---
import Base from '../layouts/Base.astro';
import images from '../data/images.json';
import { getCollection } from 'astro:content';
const titles = Object.fromEntries((await getCollection('articles', (e) => !e.data.draft)).map((e) => [e.id, e.data.cardTitle ?? e.data.title]));
const rows: any[] = [];
for (const [k, v] of Object.entries((images as any).site)) rows.push({ where: k === 'hero' ? '首页头图' : '首页案例库背景', ...(v as any) });
for (const [slug, rec] of Object.entries((images as any).articles)) {
  if (!titles[slug]) continue;
  const r = rec as any;
  rows.push({ where: `${titles[slug]}（封面）`, ...r.cover });
  r.inline.forEach((x: any, i: number) => rows.push({ where: `${titles[slug]}（插图 ${i + 1}）`, ...x }));
}
---
<Base title="图片版权说明" description="流媒笔记站内图片的来源、作者与授权许可说明。" campaign="credits">
  <section class="pagehead"><div class="container"><h1>图片版权说明</h1><p>本站配图均来自公共领域（CC0 / Public Domain Mark）图片，经 Openverse 检索，来源包括 Wikimedia Commons（含 Unsplash 作者以 CC0 发布的作品）、rawpixel 公共领域图库、StockSnap 与 WordPress Photo Directory。CC0 不要求署名，我们仍在此列出作者与原始出处以示感谢。</p></div></section>
  <section class="section container">
    <div class="table-wrap">
      <table class="credits">
        <thead><tr><th>使用位置</th><th>作者</th><th>来源</th><th>许可</th></tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr><td>{r.where}</td><td>{r.credit.creator}</td><td>{r.credit.landing ? <a href={r.credit.landing} target="_blank" rel="noopener nofollow">{r.credit.source_name}</a> : r.credit.source_name}</td><td>{r.credit.license_url ? <a href={r.credit.license_url} target="_blank" rel="noopener nofollow">{r.credit.license}</a> : r.credit.license}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Base>
